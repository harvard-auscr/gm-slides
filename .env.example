# Copy this file to `.env` (git-ignored) and fill in what you use. Both features
# are optional and share the sign-in at the bottom. With no `.env`, the generator
# reads the file you pass and uploads nothing.

# --- Google Sheet source (README "Google Sheet source") -----------------------
# Paste the link of the sheet behind the shout-out form (the tab in the link is
# the one that is read). The weekly command then needs no downloaded file:
#     python generate_shoutouts.py --gm 26 --date 9.24 --since "9.17 20:00"
# The signed-in account (below) must be able to open the sheet.
SHOUTOUT_SHEET=

# --- Google Drive upload (README "Google Drive upload") -----------------------
# The Drive folder the decks should land in: paste the folder's link (or its ID),
# e.g. DRIVE_FOLDER=https://drive.google.com/drive/folders/<folder ID>
# Leave it empty to keep the sheet source without uploading anything.
DRIVE_FOLDER=

# Kill switch: `off` keeps everything configured but skips the upload.
#DRIVE_UPLOAD=off

# --- Sign-in (shared by both) ---------------------------------------------------
# An OAuth "Desktop app" client from the Google Cloud console -- either paste its
# ID + secret here, or point DRIVE_CLIENT_FILE at the downloaded JSON.
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
#DRIVE_CLIENT_FILE=.google/credentials.json

# Where the signed-in token is cached after the one-time browser consent.
# Relative paths are relative to this file.
#DRIVE_TOKEN_FILE=.google/token.json
